# 默认按文本处理，统一以 LF 存储
* text=auto eol=lf

# 源码与配置文件
*.java      text eol=lf
*.xml       text eol=lf
*.properties text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf

# 跨平台脚本
*.sh        text eol=lf
mvnw        text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf
mvnw.cmd    text eol=crlf

# 二进制文件
*.jar       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
